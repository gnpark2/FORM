# No secret below may use a NEXT_PUBLIC_ prefix. Copy to .env.local.
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Supabase Connect > Transaction pooler (port 6543). Percent-encode the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=verify-full
SUPABASE_STORAGE_BUCKET=wardrobe
# Optional: existing AI provider; leave both unset to use clearly labelled basic recommendations.
# CF_AI_ACCOUNT_ID=
# CF_AI_TOKEN=
